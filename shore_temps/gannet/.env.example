# Copy to .env and fill in. Never commit .env.
# PUID/PGID: run `id` over SSH on Gannet as the user that owns the project folder.
PUID=1026
PGID=100
# One long random token per hub. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_TOKENS=shore-temps-a:REPLACE_ME,shore-temps-b:REPLACE_ME
